<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" type=image/x-icon href="/images/LogoITS.png">
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title inertia>
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Oxygen:wght@300;400;700&display=swap"
      rel="stylesheet"
    />

    @vite(['inertia/app/app.ts', 'inertia/css/app.css', `inertia/pages/${page.component}.vue`])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body class="min-h-screen bg-[#ecf0f5] transition-all dark:bg-dark-primary">
    <div class="font-nunito">
      @inertia()
    </div>
  </body>

</html>
